#!/bin/sh
# Primary entry point of the AppImage. AppImage runtime supplies APPDIR & APPIMAGE.
set -eu
HERE=${APPDIR:-"$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"}
export APPDIR="$HERE"
case "${1:-}" in
  --sorter) shift; exec "$HERE/usr/bin/Sorter" "$@" ;;
  --config) shift; exec "$HERE/usr/bin/Sorter.Config" "$@" ;;
  --update) shift; exec python3 "$HERE/usr/bin/Sorter.Updater" --appimage "${APPIMAGE:?APPIMAGE is not set; run from the mounted AppImage}" --install "$@" ;;
  --check-updates) shift; exec python3 "$HERE/usr/bin/Sorter.Updater" --appimage "${APPIMAGE:?APPIMAGE is not set}" --check "$@" ;;
  --updater) shift; exec python3 "$HERE/usr/bin/Sorter.Updater" "$@" ;;
  --autostart) shift; exec "$HERE/usr/bin/Sorter" --autostart "$@" ;;
  --help|-h)
    echo 'File Sorter v1.3.7 AppImage'
    echo 'Run without options for the graphical launcher.'
    echo '--sorter [--autostart]   Start sorter GUI'
    echo '--config                Start config GUI'
    echo '--check-updates         Check GitHub for a newer AppImage'
    echo '--update                Install a newer AppImage (if available)'
    exit 0 ;;
  '') exec "$HERE/usr/bin/File-Sorter-Launcher" ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
