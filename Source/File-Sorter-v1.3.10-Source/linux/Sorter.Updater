#!/usr/bin/env python3
"""Safely update File Sorter's three local program files from a GitHub release ZIP.

The ZIP filename must be File-Sorter-vMAJOR.MINOR.PATCH-Arch-Linux.zip.
User configuration is intentionally not installed or modified by this updater.
"""
import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
import time
import urllib.error
import urllib.request
import zipfile

API = 'https://api.github.com/repos/gadzooksie/File-Sorter/releases/latest'
ASSET_PREFIX = 'https://github.com/gadzooksie/File-Sorter/releases/download/'
ASSET_NAME = re.compile(r'^File-Sorter-v(\d+)\.(\d+)\.(\d+)-Arch-Linux\.zip$')
BUILD_VERSION = (1, 3, 10)
EXECUTABLES = ('Sorter', 'Sorter.Config', 'Sorter.Updater')
MAX_ZIP_SIZE = 80 * 1024 * 1024
MAX_ELF_SIZE = 40 * 1024 * 1024
USER_AGENT = 'File-Sorter-Updater/1.3.10 (+https://github.com/gadzooksie/File-Sorter)'


class UpdateError(Exception):
    pass


def config_dir():
    xdg = os.getenv('XDG_CONFIG_HOME', '')
    if not xdg.startswith('/'):
        xdg = os.path.join(os.path.expanduser('~'), '.config')
    return Path(xdg) / 'sorter-config'


def request(url):
    req = urllib.request.Request(url, headers={
        'User-Agent': USER_AGENT,
        'Accept': 'application/vnd.github+json',
    })
    return urllib.request.urlopen(req, timeout=25)


def get_latest():
    try:
        with request(API) as response:
            raw = response.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise UpdateError('GitHub release metadata was unexpectedly large.')
        release = json.loads(raw)
    except (OSError, ValueError, urllib.error.URLError, TimeoutError) as exc:
        raise UpdateError(f'Unable to read GitHub latest release: {exc}') from exc
    if not isinstance(release, dict) or release.get('draft') or release.get('prerelease'):
        raise UpdateError('Latest GitHub release is not a published stable release.')
    tag = release.get('tag_name', '')
    if not isinstance(tag, str) or not re.fullmatch(r'[\w.-]{1,100}', tag, flags=re.ASCII):
        raise UpdateError('Release tag is invalid.')
    candidates = []
    for item in release.get('assets', []):
        if not isinstance(item, dict):
            continue
        name = item.get('name', '')
        match = ASSET_NAME.fullmatch(name) if isinstance(name, str) else None
        if not match:
            continue
        size = item.get('size')
        digest = item.get('digest', '')
        url = item.get('browser_download_url', '')
        if (not isinstance(size, int) or isinstance(size, bool) or not 0 < size <= MAX_ZIP_SIZE or
                not isinstance(digest, str) or not re.fullmatch('sha256:[0-9a-fA-F]{64}', digest) or
                not isinstance(url, str) or not url.startswith(ASSET_PREFIX) or
                not url.endswith('/' + name)):
            raise UpdateError(f'Invalid GitHub asset metadata: {name}')
        candidates.append((tuple(map(int, match.groups())), {
            'name': name, 'size': size, 'digest': digest.split(':')[1].lower(),
            'url': url, 'tag': tag,
        }))
    if len(candidates) != 1:
        raise UpdateError('Latest release must include exactly one versioned Arch-Linux ZIP with a SHA-256 digest.')
    return candidates[0]


def sha256(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        while chunk := stream.read(256 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def installed_gui_version(folder):
    """Identify the installed pair, not the version of this updater helper.

    A newer helper may have been copied alongside older GUI binaries, so using
    BUILD_VERSION as the installed version would wrongly suppress an update.
    """
    patterns = {
        'Sorter': rb'File Sorter v(\d+)\.(\d+)\.(\d+)\nUsage: Sorter\b',
        'Sorter.Config': rb'File Sorter Config GUI v(\d+)\.(\d+)\.(\d+)\nUsage: Sorter\.Config\b',
    }
    versions = []
    for name, pattern in patterns.items():
        path = folder / name
        if path.is_symlink() or not path.is_file() or path.stat().st_size > MAX_ELF_SIZE:
            return (0, 0, 0)
        try:
            match = re.search(pattern, path.read_bytes())
        except OSError:
            return (0, 0, 0)
        if not match:
            return (0, 0, 0)
        versions.append(tuple(map(int, match.groups())))
    # If only one executable is older, update both to restore consistency.
    return min(versions)


def marker_path():
    return config_dir() / 'installed-release.json'


def read_marker():
    try:
        data = json.loads(marker_path().read_text(encoding='utf-8'))
        if isinstance(data, dict) and isinstance(data.get('version'), str):
            return data
    except (ValueError, OSError):
        pass
    return {}


def record_matches(marker, folder):
    hashes = marker.get('file_hashes')
    if not isinstance(hashes, dict) or set(hashes) != set(EXECUTABLES):
        return False
    for name in EXECUTABLES:
        path = folder / name
        if (path.is_symlink() or not path.is_file() or
                not isinstance(hashes[name], str) or sha256(path) != hashes[name]):
            return False
    return True


def save_marker(version, asset, folder):
    path = marker_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    record = {
        'version': '.'.join(map(str, version)),
        'tag': asset['tag'],
        'asset_digest': asset['digest'],
        'file_hashes': {name: sha256(folder / name) for name in EXECUTABLES},
    }
    fd, temp = tempfile.mkstemp(dir=path.parent, prefix='.release-')
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            json.dump(record, stream)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def download_zip(folder, asset):
    fd, name = tempfile.mkstemp(dir=folder, prefix='.sorter-archive-', suffix='.zip')
    count = 0
    hasher = hashlib.sha256()
    try:
        with os.fdopen(fd, 'wb') as out:
            with request(asset['url']) as response:
                while chunk := response.read(256 * 1024):
                    count += len(chunk)
                    if count > asset['size'] or count > MAX_ZIP_SIZE:
                        raise UpdateError('Release download exceeded its expected size.')
                    hasher.update(chunk)
                    out.write(chunk)
            out.flush()
            os.fsync(out.fileno())
        if count != asset['size'] or hasher.hexdigest() != asset['digest']:
            raise UpdateError('Release ZIP failed SHA-256 or size verification.')
        return name
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(name)
        raise


def is_elf_x64(path):
    with open(path, 'rb') as source:
        header = source.read(20)
    return (len(header) == 20 and header[:4] == b'\x7fELF' and
            header[4:6] == b'\x02\x01' and header[18:20] == b'\x3e\x00')


def stage_programs(folder, zip_path):
    staged = {}
    try:
        with zipfile.ZipFile(zip_path) as archive:
            entries = archive.infolist()
            if len(entries) > 160:
                raise UpdateError('Release archive contains too many files.')
            seen = set()
            for entry in entries:
                name = entry.filename
                if (name in seen or name.startswith('/') or '\\' in name or '\x00' in name or
                        any(part in ('', '.', '..') for part in name.rstrip('/').split('/'))):
                    raise UpdateError('Unsafe or duplicate ZIP entry detected.')
                seen.add(name)
            for name in EXECUTABLES:
                if name not in seen:
                    raise UpdateError(f'Release archive is missing: {name}')
                entry = archive.getinfo(name)
                mode = (entry.external_attr >> 16) & 0o170000
                if entry.is_dir() or mode == stat.S_IFLNK:
                    raise UpdateError(f'Executable ZIP entry is not a regular file: {name}')
                limit = MAX_ELF_SIZE if name != 'Sorter.Updater' else 1024 * 1024
                if not 0 < entry.file_size <= limit:
                    raise UpdateError(f'Executable ZIP entry has an invalid size: {name}')
                fd, temp = tempfile.mkstemp(dir=folder, prefix='.sorter-stage-')
                staged[name] = temp
                with os.fdopen(fd, 'wb') as dest, archive.open(entry) as source:
                    copied = 0
                    while chunk := source.read(256 * 1024):
                        copied += len(chunk)
                        if copied > limit:
                            raise UpdateError('Uncompressed release entry exceeded size limit.')
                        dest.write(chunk)
                    dest.flush()
                    os.fsync(dest.fileno())
                if copied != entry.file_size:
                    raise UpdateError(f'ZIP entry length is wrong: {name}')
                if name != 'Sorter.Updater':
                    if not is_elf_x64(temp):
                        raise UpdateError(f'Not a Linux x86-64 ELF executable: {name}')
                else:
                    with open(temp, 'rb') as script:
                        if script.readline(128).strip() != b'#!/usr/bin/env python3':
                            raise UpdateError('Updater entry is not the expected Python 3 script.')
                os.chmod(temp, 0o755)
        return staged
    except BaseException:
        for temp in staged.values():
            with contextlib.suppress(OSError):
                os.unlink(temp)
        raise


def replace_programs(folder, staged):
    backups = {}
    replaced = []
    try:
        for name in EXECUTABLES:
            dest = folder / name
            if dest.is_symlink() or (dest.exists() and not dest.is_file()):
                raise UpdateError(f'Unsafe executable destination: {dest}')
            if dest.exists():
                fd, temp = tempfile.mkstemp(dir=folder, prefix='.sorter-backup-')
                with os.fdopen(fd, 'wb') as backup, open(dest, 'rb') as source:
                    shutil.copyfileobj(source, backup)
                    backup.flush()
                    os.fsync(backup.fileno())
                os.chmod(temp, dest.stat().st_mode & 0o777)
                backups[name] = temp
            else:
                backups[name] = None
        for name in EXECUTABLES:
            os.replace(staged.pop(name), folder / name)
            replaced.append(name)
    except BaseException:
        for name in reversed(replaced):
            dest = folder / name
            backup = backups[name]
            try:
                if backup is not None:
                    os.replace(backup, dest)
                    backups[name] = None
                else:
                    dest.unlink(missing_ok=True)
            except OSError as exc:
                print(f'WARNING: Could not restore {dest}: {exc}', file=sys.stderr)
        raise
    finally:
        for temp in list(backups.values()) + list(staged.values()):
            if temp:
                with contextlib.suppress(OSError):
                    os.unlink(temp)


def run(args):
    folder = Path(args.app_dir).expanduser().resolve()
    if not folder.is_dir():
        raise UpdateError(f'Application directory does not exist: {folder}')
    cfg = config_dir()
    cfg.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(cfg / 'updater.lock', 'a+b') as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not args.quiet:
                print('Another File Sorter update is running.', flush=True)
            return 0
        if args.auto:
            stamp = cfg / 'last-auto-check'
            try:
                if time.time() - float(stamp.read_text(encoding='ascii')) < 6 * 3600:
                    return 0
            except (OSError, ValueError):
                pass
        version, asset = get_latest()
        marker = read_marker()
        installed_version = installed_gui_version(folder)
        if record_matches(marker, folder):
            try:
                saved_ver = tuple(int(x) for x in marker['version'].split('.'))
                if len(saved_ver) == 3:
                    installed_version = max(installed_version, saved_ver)
            except (KeyError, ValueError):
                pass
        if version <= installed_version:
            if not args.quiet:
                print(f'Up to date: installed v{".".join(map(str, installed_version))}', flush=True)
        elif (marker.get('asset_digest') == asset['digest'] and
              marker.get('version') == '.'.join(map(str, version)) and
              record_matches(marker, folder)):
            if not args.quiet:
                print('Up to date: ' + asset['name'], flush=True)
        elif not args.install:
            print('New release available: ' + asset['name'], flush=True)
        else:
            print('Downloading verified release: ' + asset['name'], flush=True)
            zip_path = download_zip(folder, asset)
            try:
                staged = stage_programs(folder, zip_path)
                replace_programs(folder, staged)
                save_marker(version, asset, folder)
            finally:
                os.unlink(zip_path)
            print('Updated all three applications. Restart File Sorter and its config editor.', flush=True)
        if args.auto:
            (cfg / 'last-auto-check').write_text(str(time.time()), encoding='ascii')
    return 0



# AppImage update mode is intentionally separate from the legacy three-file ZIP
# updater. The AppImage is a single immutable executable, not a writable AppDir.
APPIMAGE_ASSET = re.compile(r'^File-Sorter-v(\d+)\.(\d+)\.(\d+)-x86_64\.AppImage$')
MAX_APPIMAGE_SIZE = 300 * 1024 * 1024


def latest_appimage():
    try:
        with request(API) as response:
            raw = response.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise UpdateError('GitHub release metadata too large.')
        release = json.loads(raw)
    except (ValueError, OSError, urllib.error.URLError) as exc:
        raise UpdateError(f'Cannot read GitHub release metadata: {exc}') from exc
    if not isinstance(release, dict) or release.get('draft') or release.get('prerelease'):
        raise UpdateError('Latest GitHub release is not stable.')
    tag = release.get('tag_name', '')
    if not isinstance(tag, str) or not re.fullmatch(r'[\w.-]{1,100}', tag, re.ASCII):
        raise UpdateError('Invalid release tag.')
    matches = []
    for asset in release.get('assets', []):
        if not isinstance(asset, dict):
            continue
        name = asset.get('name', '')
        match = APPIMAGE_ASSET.fullmatch(name) if isinstance(name, str) else None
        if match:
            size = asset.get('size')
            digest = asset.get('digest', '')
            url = asset.get('browser_download_url', '')
            if (not isinstance(size, int) or isinstance(size, bool) or
                    not 1024 < size < MAX_APPIMAGE_SIZE or not isinstance(digest, str) or
                    not re.fullmatch(r'sha256:[0-9a-fA-F]{64}', digest) or
                    not isinstance(url, str) or not url.startswith(ASSET_PREFIX) or
                    not url.endswith('/' + name)):
                raise UpdateError(f'Invalid AppImage asset metadata: {name}')
            matches.append((tuple(map(int, match.groups())), {
                'name': name, 'size': size, 'digest': digest.partition(':')[2].lower(),
                'url': url, 'tag': tag,
            }))
    if not matches:
        return None
    if len(matches) != 1:
        raise UpdateError('Release contains multiple matching AppImages.')
    return matches[0]


def is_x64_appimage(file):
    with open(file, 'rb') as source:
        header = source.read(20)
    return (len(header) == 20 and header[:4] == b'\x7fELF' and
            header[4:6] == b'\x02\x01' and header[8:11] == b'AI\x02' and
            header[18:20] == b'\x3e\x00')


def install_appimage(dest, asset):
    # Download to same directory, verify before replace, never touch settings.
    if dest.is_symlink() or not dest.is_file() or not is_x64_appimage(dest):
        raise UpdateError('Installed AppImage is not a safe x86-64 AppImage file.')
    fd, name = tempfile.mkstemp(dir=dest.parent, prefix='.file-sorter-update-', suffix='.AppImage')
    staged = Path(name)
    try:
        copied = 0
        digest = hashlib.sha256()
        with os.fdopen(fd, 'wb') as stream, request(asset['url']) as response:
            while block := response.read(262144):
                copied += len(block)
                if copied > asset['size'] or copied > MAX_APPIMAGE_SIZE:
                    raise UpdateError('AppImage exceeded expected download size.')
                digest.update(block)
                stream.write(block)
            stream.flush()
            os.fsync(stream.fileno())
        if copied != asset['size'] or digest.hexdigest() != asset['digest']:
            raise UpdateError('AppImage download SHA-256 or size mismatch.')
        if not is_x64_appimage(staged):
            raise UpdateError('Release asset is not a valid x86-64 AppImage header.')
        staged.chmod(0o755)
        # Back up to a separate path so recovery is possible if the new build fails.
        backup = dest.with_name(dest.name + '.previous')
        if backup.is_symlink() or (backup.exists() and not backup.is_file()):
            raise UpdateError('AppImage backup path is not a regular file.')
        fd_backup, temp_backup = tempfile.mkstemp(dir=dest.parent, prefix='.file-sorter-backup-')
        try:
            with os.fdopen(fd_backup, 'wb') as output, open(dest, 'rb') as original:
                shutil.copyfileobj(original, output)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(temp_backup, dest.stat().st_mode & 0o777)
            os.replace(temp_backup, backup)
            os.replace(staged, dest)
        finally:
            if os.path.exists(temp_backup):
                os.unlink(temp_backup)
    finally:
        staged.unlink(missing_ok=True)


def run_appimage(args):
    dest = Path(os.path.abspath(os.path.expanduser(args.appimage)))
    if not dest.is_file() or dest.is_symlink():
        raise UpdateError('AppImage path must refer to an existing regular file, not a symlink.')
    cfg = config_dir()
    cfg.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(cfg / 'updater.lock', 'a+b') as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not args.quiet:
                print('An update is already running.', flush=True)
            return 0
        if args.auto:
            stamp = cfg / 'last-auto-check-appimage'
            try:
                if time.time() - float(stamp.read_text()) < 6 * 3600:
                    return 0
            except (OSError, ValueError):
                pass
        result = latest_appimage()
        if not result:
            if not args.quiet:
                print('Latest release does not contain an AppImage yet.', flush=True)
        else:
            version, asset = result
            # The script is embedded in the running AppImage. Its build version
            # is the version of the running GUI even if the AppImage was renamed.
            if version <= BUILD_VERSION:
                if not args.quiet:
                    print('Up to date: v' + '.'.join(map(str, BUILD_VERSION)), flush=True)
            elif not args.install:
                print('New AppImage available: ' + asset['name'], flush=True)
            else:
                print('Downloading verified AppImage: ' + asset['name'], flush=True)
                install_appimage(dest, asset)
                print('AppImage installed. Close all File Sorter windows and restart.', flush=True)
        if args.auto:
            (cfg / 'last-auto-check-appimage').write_text(str(time.time()), encoding='ascii')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description='Update File Sorter from GitHub Releases')
    parser.add_argument('--version', action='version', version='File Sorter Updater v1.3.10')
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument('--app-dir', help='Directory of separate ELF programs')
    target.add_argument('--appimage', help='Path to one installed File Sorter AppImage')
    parser.add_argument('--current-tag', default=None, help='Legacy compatibility; version comes from ZIP filename')
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--install', action='store_true')
    parser.add_argument('--auto', action='store_true', help='Install automatically, at most once every 6 hours')
    parser.add_argument('--quiet', action='store_true')
    args = parser.parse_args(argv)
    if not (args.check or args.install or args.auto):
        parser.error('Choose --check, --install or --auto.')
    if args.auto:
        args.install = True
        args.quiet = True
    try:
        return run_appimage(args) if args.appimage else run(args)
    except (UpdateError, OSError, zipfile.BadZipFile) as exc:
        print('Update failed: ' + str(exc), file=sys.stderr, flush=True)
        return 1


if __name__ == '__main__':
    sys.exit(main())
